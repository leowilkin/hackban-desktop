-  "inlineSchema": "// Hackban schema (PostgreSQL).\n\ngenerator client {\n  provider      = \"prisma-client-js\"\n  output        = \"../generated/prisma\"\n  // native for local dev; openssl-3 for the bookworm runtime image\n  binaryTargets = [\"native\", \"debian-openssl-3.0.x\"]\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\n// ---------- Auth (NextAuth) ----------\n\nmodel Account {\n  id                       String  @id @default(cuid())\n  userId                   String\n  type                     String\n  provider                 String\n  providerAccountId        String\n  refresh_token            String?\n  access_token             String?\n  expires_at               Int?\n  token_type               String?\n  scope                    String?\n  id_token                 String?\n  session_state            String?\n  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  refresh_token_expires_in Int?\n\n  @@unique([provider, providerAccountId])\n}\n\nmodel Session {\n  id           String   @id @default(cuid())\n  sessionToken String   @unique\n  userId       String\n  expires      DateTime\n  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel VerificationToken {\n  identifier String\n  token      String   @unique\n  expires    DateTime\n\n  @@unique([identifier, token])\n}\n\nmodel User {\n  id            String    @id @default(cuid())\n  name          String?\n  username      String?   @unique\n  email         String?   @unique\n  emailVerified DateTime?\n  image         String?\n  // Uploaded avatar (\"storageKey:mime\"). While set, `image` points at it and\n  // the original (Slack) URL waits in `providerImage` for when it's removed.\n  avatarKey     String?\n  providerImage String?\n  // Ghost users are created by the Trello importer for members who haven't\n  // signed in yet; they are merged into the real account on first login.\n  isGhost       Boolean   @default(false)\n  // Set on ghosts invited by email (lowercase); merged into whoever first\n  // logs in with that email.\n  invitedEmail  String?   @unique\n  // Site-wide admin (the /admin panel). Seeded from ADMIN_EMAILS on login.\n  isAdmin       Boolean   @default(false)\n  // Added to #hackban once on login; never again, so leaving the channel sticks.\n  slackJoined   Boolean   @default(false)\n  trelloId      String?   @unique\n  createdAt     DateTime  @default(now())\n\n  accounts         Account[]\n  sessions         Session[]\n  workspaces       WorkspaceMember[]\n  boards           BoardMember[]\n  stars            BoardStar[]\n  cards            CardMember[]\n  comments         Comment[]\n  activities       Activity[]          @relation(\"actor\")\n  notifications    Notification[]\n  checkItems       CheckItem[]\n  attachments      Attachment[]\n  imports          TrelloImport[]\n  watches          Watch[]\n  autoJoinsCreated WorkspaceAutoJoin[] @relation(\"autoJoinCreator\")\n  oauthTokens      OAuthToken[]\n}\n\n// ---------- Workspaces & boards ----------\n\nmodel Workspace {\n  id          String   @id @default(cuid())\n  name        String\n  description String?\n  // Uploaded logo (storage key); null shows the colored initial instead.\n  logoKey     String?\n  trelloId    String?  @unique\n  createdAt   DateTime @default(now())\n\n  members   WorkspaceMember[]\n  boards    Board[]\n  autoJoins WorkspaceAutoJoin[]\n}\n\n/// Anyone who logs in with an email on `domain` is added to the workspace.\nmodel WorkspaceAutoJoin {\n  id          String    @id @default(cuid())\n  workspaceId String\n  domain      String // lowercase, no \"@\", e.g. \"hackclub.com\"\n  role        String    @default(\"normal\") // admin | normal\n  createdById String?\n  createdAt   DateTime  @default(now())\n  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)\n  createdBy   User?     @relation(\"autoJoinCreator\", fields: [createdById], references: [id], onDelete: SetNull)\n\n  @@unique([workspaceId, domain])\n  @@index([domain])\n}\n\nmodel WorkspaceMember {\n  workspaceId String\n  userId      String\n  role        String    @default(\"normal\") // admin | normal\n  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)\n  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@id([workspaceId, userId])\n}\n\nmodel Board {\n  id          String    @id @default(cuid())\n  name        String\n  description String?\n  workspaceId String\n  background  String    @default(\"#0079bf\") // css color or gradient\n  bgImage     String?\n  visibility  String    @default(\"workspace\") // private | workspace | public\n  closed      Boolean   @default(false)\n  // \"Join this board\" link: anyone with it can join as a board-only guest.\n  // null = link disabled. Resetting issues a new token.\n  inviteToken String?   @unique\n  inviteRole  String    @default(\"normal\") // normal | observer\n  trelloId    String?   @unique\n  createdAt   DateTime  @default(now())\n  updatedAt   DateTime  @updatedAt\n  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)\n\n  members    BoardMember[]\n  stars      BoardStar[]\n  lists      List[]\n  labels     Label[]\n  activities Activity[]\n  watches    Watch[]\n}\n\nmodel BoardMember {\n  boardId    String\n  userId     String\n  role       String    @default(\"normal\") // admin | normal | observer\n  lastViewed DateTime?\n  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)\n  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@id([boardId, userId])\n}\n\nmodel BoardStar {\n  boardId String\n  userId  String\n  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)\n  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@id([boardId, userId])\n}\n\nmodel List {\n  id        String   @id @default(cuid())\n  boardId   String\n  name      String\n  pos       String // fractional index\n  color     String? // label color name, null = no color\n  closed    Boolean  @default(false)\n  trelloId  String?  @unique\n  createdAt DateTime @default(now())\n  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)\n  cards     Card[]\n\n  @@index([boardId, pos])\n}\n\nmodel Card {\n  id                String    @id @default(cuid())\n  listId            String\n  title             String\n  description       String    @default(\"\")\n  pos               String\n  start             DateTime?\n  due               DateTime?\n  dueComplete       Boolean   @default(false)\n  // Repeat: daily | weekdays | weekly | monthly | yearly (null = doesn't repeat).\n  // Completing a repeating card advances its dates and resets it.\n  recurrence        String?\n  coverColor        String?\n  coverAttachmentId String?\n  coverSize         String    @default(\"normal\") // normal | full\n  closed            Boolean   @default(false)\n  trelloId          String?   @unique\n  shortId           Int       @default(0)\n  createdAt         DateTime  @default(now())\n  updatedAt         DateTime  @updatedAt\n  list              List      @relation(fields: [listId], references: [id], onDelete: Cascade)\n\n  labels      CardLabel[]\n  members     CardMember[]\n  checklists  Checklist[]\n  attachments Attachment[]\n  comments    Comment[]\n  activities  Activity[]\n  watches     Watch[]\n  blocking    CardBlock[]  @relation(\"blocker\")\n  blockedBy   CardBlock[]  @relation(\"blocked\")\n\n  @@index([listId, pos])\n}\n\n/// `blocker` has to be completed (or archived) before `blocked` can go ahead.\n/// Both cards are on the same board.\nmodel CardBlock {\n  blockerId String\n  blockedId String\n  blocker   Card   @relation(\"blocker\", fields: [blockerId], references: [id], onDelete: Cascade)\n  blocked   Card   @relation(\"blocked\", fields: [blockedId], references: [id], onDelete: Cascade)\n\n  @@id([blockerId, blockedId])\n  @@index([blockedId])\n}\n\nmodel Label {\n  id       String      @id @default(cuid())\n  boardId  String\n  name     String      @default(\"\")\n  color    String? // trello color name, null = no color\n  trelloId String?     @unique\n  board    Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)\n  cards    CardLabel[]\n}\n\nmodel CardLabel {\n  cardId  String\n  labelId String\n  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)\n  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)\n\n  @@id([cardId, labelId])\n}\n\nmodel CardMember {\n  cardId String\n  userId String\n  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)\n  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@id([cardId, userId])\n}\n\nmodel Checklist {\n  id       String      @id @default(cuid())\n  cardId   String\n  name     String\n  pos      String\n  trelloId String?     @unique\n  card     Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)\n  items    CheckItem[]\n}\n\nmodel CheckItem {\n  id          String    @id @default(cuid())\n  checklistId String\n  name        String\n  pos         String\n  complete    Boolean   @default(false)\n  due         DateTime?\n  memberId    String?\n  trelloId    String?   @unique\n  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)\n  member      User?     @relation(fields: [memberId], references: [id], onDelete: SetNull)\n}\n\nmodel Attachment {\n  id         String   @id @default(cuid())\n  cardId     String\n  uploaderId String?\n  name       String\n  url        String // external url or /api/files/<id>\n  mimeType   String?\n  size       Int?\n  isUpload   Boolean  @default(false)\n  storageKey String?\n  trelloId   String?  @unique\n  createdAt  DateTime @default(now())\n  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)\n  uploader   User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)\n}\n\nmodel Comment {\n  id        String    @id @default(cuid())\n  cardId    String\n  authorId  String\n  text      String\n  trelloId  String?   @unique\n  createdAt DateTime  @default(now())\n  editedAt  DateTime?\n  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)\n  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)\n}\n\nmodel Activity {\n  id        String   @id @default(cuid())\n  boardId   String\n  cardId    String?\n  actorId   String\n  type      String\n  data      String   @default(\"{}\") // JSON\n  createdAt DateTime @default(now())\n  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)\n  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)\n  actor     User     @relation(\"actor\", fields: [actorId], references: [id], onDelete: Cascade)\n\n  @@index([boardId, createdAt])\n  @@index([cardId, createdAt])\n}\n\nmodel Watch {\n  id      String  @id @default(cuid())\n  userId  String\n  boardId String?\n  cardId  String?\n  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  board   Board?  @relation(fields: [boardId], references: [id], onDelete: Cascade)\n  card    Card?   @relation(fields: [cardId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, boardId, cardId])\n}\n\nmodel Notification {\n  id        String   @id @default(cuid())\n  userId    String\n  type      String\n  data      String   @default(\"{}\")\n  read      Boolean  @default(false)\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId, createdAt])\n}\n\nmodel TrelloImport {\n  id        String   @id @default(cuid())\n  userId    String\n  source    String // api | json\n  status    String   @default(\"pending\") // pending | running | done | error\n  log       String   @default(\"[]\") // JSON array of messages\n  result    String   @default(\"{}\")\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\n// ---------- MCP (OAuth 2.1) ----------\n\n// Apps that registered themselves via dynamic client registration (Claude, Cursor, …).\nmodel OAuthClient {\n  id           String       @id @default(cuid())\n  name         String\n  redirectUris String[]\n  secretHash   String? // null = public client (PKCE only)\n  createdAt    DateTime     @default(now())\n  tokens       OAuthToken[]\n}\n\n// Authorization codes, access tokens and refresh tokens. Only hashes are stored.\nmodel OAuthToken {\n  hash        String      @id // sha256 of the token\n  kind        String // code | access | refresh\n  clientId    String\n  userId      String\n  redirectUri String? // code only\n  challenge   String? // code only: PKCE S256 challenge\n  usedAt      DateTime? // codes and refresh tokens are single-use; kept until expiry to catch replays\n  expiresAt   DateTime\n  createdAt   DateTime    @default(now())\n  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)\n  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId, clientId])\n  @@index([expiresAt])\n}\n",
